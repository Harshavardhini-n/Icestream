# IceStream development defaults.
# Real secrets and credentials must never be committed to this repository.

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CHECKOUT_TOPIC=checkout-events
KAFKA_DLQ_TOPIC=checkout-dlq
KAFKA_CONTROL_TOPIC=icestream-control

ICEBERG_REST_URI=http://localhost:8181
ICEBERG_WAREHOUSE=s3://warehouse/

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password

API_HOST=0.0.0.0
API_PORT=8000

DQ_NULL_THRESHOLD=0.02
DQ_SCHEMA_DRIFT_ENABLED=true

LOG_LEVEL=INFO
